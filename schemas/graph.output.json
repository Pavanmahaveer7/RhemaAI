{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph.output.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "month", "nodes", "edges", "stats"],
  "properties": {
    "question_id": { "type": "string" },
    "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "nodes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "weight"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string", "maxLength": 60 },
          "weight": { "type": "integer", "minimum": 1 },
          "cluster": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "weight"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "weight": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responses_processed", "flagged_inputs"],
      "properties": {
        "responses_processed": { "type": "integer" },
        "flagged_inputs": { "type": "integer" },
        "new_concepts_vs_previous": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
