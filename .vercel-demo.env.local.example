# Copy to .vercel-demo.env.local (gitignored). Used by scripts/vercel_deploy.ps1
DEMO_SIGNIN_PASSWORD=change-me-to-a-strong-demo-password
CHECKIN_ENCRYPTION_KEY=base64-32-bytes
AGENT_SERVICE_TOKEN=uuid
INTEGRATION_WEBHOOK_SECRET=uuid
