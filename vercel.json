{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r apps/api-vercel/requirements.txt",
  "env": {
    "APP_ENV": "production",
    "CONTRACT_STORE": "auto",
    "LLM_MODE": "off",
    "EMBED_MODE": "off",
    "BETA_SHARED_STAFF_LOGIN": "true",
    "STAFF_PHONE_OTP_DEMO": "true",
    "STAFF_PHONE_REGISTER": "true",
    "FEEDBACK_CSV_PATH": "/tmp/rhema-beta-feedback.csv",
    "AUTH_SIGNIN_RATE_PER_HOUR": "10",
    "AUTH_SIGNUP_RATE_PER_HOUR": "5"
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "apps/api/**,packages/**"
    }
  }
}
