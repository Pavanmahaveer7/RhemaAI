# ---- App ----
APP_ENV=development                 # development | staging | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ---- Auth (ADR-004: Supabase Auth) ----
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # web only
SUPABASE_SERVICE_ROLE_KEY=          # server only — never ship to the browser
SUPABASE_JWT_SECRET=                # FastAPI verifies JWTs with this

# ---- LLM gateway ----
LLM_PRIMARY_PROVIDER=anthropic      # ADR-004
LLM_MODEL_INTAKE=claude-haiku-4-5-20251001
LLM_MODEL_COMPARE=claude-sonnet-5
LLM_MODEL_GRAPH_BUILDER=claude-sonnet-5
LLM_MODEL_CHECKIN_ANALYST=claude-sonnet-5
LLM_FALLBACK_PROVIDER=              # open follow-up in ADR-004
LLM_FALLBACK_MODEL=
LLM_SELF_HOSTED_URL=                # optional, e.g. vLLM/Ollama endpoint for L3
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Limits (cost & quota) ----
MAX_INPUT_TOKENS_PER_REQUEST=4000
MAX_OUTPUT_TOKENS_PER_REQUEST=1200
DAILY_TOKEN_QUOTA_PUBLIC=50000
DAILY_TOKEN_QUOTA_PASTOR=200000
MONTHLY_BUDGET_USD=50

# ---- Data ----
DATABASE_URL=postgresql://app:app@localhost:5432/church_ai   # local: docker compose; prod: Supabase
VECTOR_STORE=pgvector
GRAPH_DB=memgraph
GRAPH_DB_URL=bolt://localhost:7687
GRAPH_DB_USER=
GRAPH_DB_PASSWORD=
REDIS_URL=redis://localhost:6379    # session store + rate limits

# ---- Observability ----
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# ---- Guardrails ----
GUARDRAIL_INJECTION_THRESHOLD=0.8
GUARDRAIL_MODERATION_PROVIDER=      # e.g. llama-guard | provider moderation endpoint
PII_ENGINE=presidio

# ---- Feature flags (demo safety) ----
FF_L1_DETAILED_MODE=true
FF_L2_LIVE_REGEN=true
FF_L3_AI_ANALYSIS=true
FF_SERVE_CACHED_DEMO_RESPONSES=false

# ---- Crisis escalation ----
ESCALATION_NOTIFY_EMAIL=
ESCALATION_NOTIFY_WEBHOOK=
# Phone number only after the partner church confirms it. Leave blank until then.
CRISIS_LINE_NUMBER=
CRISIS_LINE_WHAT=A person on the team has been notified.

# ---- Screen API (/api/v1) ----
# memory saves nothing (tests). auto/postgres load the saved state at startup and save every write
# to store_state as JSONB (ADR-006). Source passages come from source_chunk: load them once with
#   cd apps/api && PYTHONPATH=src python -m app.ingest    (ADR-007; downloads are cached in .cache/sources)
CONTRACT_STORE=auto
# Shared staff password for local demo only. APP_ENV=production refuses it; staff then need their own passwords.
DEMO_SIGNIN_PASSWORD=dev-only-change-me
CHECKIN_ENCRYPTION_KEY=dev-only-change-me
AGENT_SERVICE_TOKEN=
INTEGRATION_WEBHOOK_SECRET=
EMBED_DEMO_TOKEN=
PLANNING_CENTER_CLIENT_ID=
