{
  "name": "church-ai",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:local": "pwsh -NoProfile -File ./scripts/run_local.ps1",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:ui": "node scripts/ui_smoke.mjs",
    "test:ui:install": "playwright install chromium"
  },
  "devDependencies": {
    "playwright": "^1.51.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "source-map-js": "1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": ["GHSA-wq5f-xc86-pv6w"]
    }
  }
}
